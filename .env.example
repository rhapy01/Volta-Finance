NODE_ENV=development
PORT=3000

# Neon pooled URL for the Express app. Keep this secret server-side.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require

# Neon direct URL for Drizzle migrations. Use the non-pooler hostname.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require

# Gmail SMTP for organization invitations. Use a Google App Password (not your
# normal account password); the Google account must have 2-Step Verification.
# SMTP sends with smtp.gmail.com over STARTTLS on port 587.
GOOGLE_SMTP_USER=
GOOGLE_SMTP_APP_PASSWORD=
GOOGLE_SMTP_FROM_NAME=Volta Finance
APP_BASE_URL=http://localhost:3000

# Chipnet CashToken categories must be the tokens' actual Chipnet genesis txids.
# PUSD category supplied by the project team and confirmed routable on Cauldron Chipnet.
CHIPNET_PUSD_CATEGORY=dfe50223c8d5cba8dcef8dff6d92b61deb88a8ba44947367f2b746487b56039b
CHIPNET_MUSD_CATEGORY=

# Riften Labs' Chipnet Cauldron router (quotes and unsigned swap builds).
CAULDRON_CHIPNET_ROUTER_URL=wss://router-chipnet.riften.net/v1/route

# Shared Chipnet intake address for BCH and CashTokens payments that deliver XLM.
# The invoice's saved Stellar address remains the single destination for XLM.
CHIPNET_CROSSCHAIN_DEPOSIT_ADDRESS=bchtest:zqfm0r5vaeulnndzn3ec77g5eq47jhyhuurhcuxgrl
# Legacy aliases are still accepted if the shared setting is absent.
CHIPNET_CROSSCHAIN_PUSD_ADDRESS=bchtest:zqfm0r5vaeulnndzn3ec77g5eq47jhyhuurhcuxgrl
CHIPNET_CROSSCHAIN_BCH_ADDRESS=bchtest:zqfm0r5vaeulnndzn3ec77g5eq47jhyhuurhcuxgrl
# Mainnet intake addresses must be dedicated, controlled by the project, and
# CashToken-capable for PUSD. These do not need a private key on the app server.
MAINNET_CROSSCHAIN_DEPOSIT_ADDRESS=
MAINNET_CROSSCHAIN_PUSD_ADDRESS=
MAINNET_CROSSCHAIN_BCH_ADDRESS=
# Keep this private and server-side; needed only if Volta Finance later refunds/sweeps deposits.
# CHIPNET_CROSSCHAIN_BCH_PRIVATE_KEY=

# Stellar testnet destination wallet. The private key is kept in the local
# Windows secure store under the Stellar CLI identity `trezu-testnet`.
STELLAR_NETWORK=testnet
STELLAR_TESTNET_IDENTITY=trezu-testnet
STELLAR_TESTNET_PUBLIC_KEY=GCW3HQ5C2YXLGHD26QQXS6DPD64P5W3CKP25V3Q3LKZ7JHKSXMSWU7U4
STELLAR_TESTNET_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_TESTNET_HORIZON_URL=https://horizon-testnet.stellar.org
# Optional on a deployed server: inject the test secret from a secret manager.
# Local Windows development reads the `trezu-testnet` identity from Secure Store.
# STELLAR_TESTNET_SECRET_KEY=

# EVM Testnet payout signer (keep server-side; never expose to the browser).
# Base Sepolia supports native ETH plus USDC; Arc Testnet supports USDC only.
EVM_TESTNET_SIGNER_PRIVATE_KEY=
EVM_MAINNET_SIGNER_PRIVATE_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
BASE_SEPOLIA_ETH_USD_RATE=
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
BASE_MAINNET_RPC_URL=https://mainnet.base.org
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
MUSD=no
